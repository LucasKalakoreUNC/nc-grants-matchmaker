                                            <div class="document-wrap" role="document">
                                                <main id="main-content" class="main">
                                     <div class="basic-page">
  <div class="ncst-default-header">
  <h1>Wolfpack 2030: Powering the Extraordinary</h1>
      <p class="ncst-default-header__intro">
      NC&#160;State's 2021-2030 Strategic Plan
    </p>
  </div>

  <div class="basic-page__content ncst-wrap__content">
    



<ul class="wp-block-ncst-link-list ncst-link-list layout-one-column"><div class="link-list__container"></div></ul>




<p class="wp-block-paragraph">The 2021-2030 Strategic Plan was endorsed by the NC State Board of Trustees on April 16, 2021.</p>


<ul class="wp-block-ncst-link-list ncst-link-list layout-one-column"><div class="link-list__container"><li class="ncst-component__bold-link-container wp-block-ncst-bold-link">
      <a 
      href="#introduction"
      class="ncst-component__bold-link text-link"
                >
    <span class="text">Introduction</span><span class="arrow-indicator"><svg class="wolficon wolficon-arrow-right-bold" role="img"  aria-hidden="true">
			
			<use xlink:href="#wolficon-arrow-right-bold">
		</svg></span>
    </a>
      </li>
  

